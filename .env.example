# --- Backend (copy to repo root .env; Nest loads via ConfigModule) ---
NODE_ENV=development
PORT=3000

# PostgreSQL on host or managed — no Docker in this repo
DATABASE_URL=postgresql://parton:parton@localhost:5432/parton?schema=public

JWT_ACCESS_SECRET=change-me-use-openssl-rand-base64-48-min-32-chars
JWT_ACCESS_TTL_SECONDS=1800
JWT_REFRESH_TTL_DAYS=30
OTP_PEPPER=change-me-use-openssl-rand-base64-24-min-16-chars

# Real SMS sandbox (Twilio) — required for auth; no console/noop provider
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# CORS (admin + marketing dev servers)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
COOKIE_SECURE=false

# Object storage (S3-compatible — host MinIO or cloud bucket)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=parton-documents
WORKER_DOCUMENT_MAX_BYTES=10485760
WORKER_DOCUMENT_ALLOWED_MIME=application/pdf,image/jpeg,image/png
RATING_OPEN_DELAY_HOURS=24

# FCM (required when notifications module is enabled)
FCM_SERVICE_ACCOUNT_PATH=

# Optional Stage B (off by default — outbox in-process drain)
BULLMQ_ENABLED=false
REDIS_QUEUE_URL=redis://localhost:6379/0
SSE_TICKET_TTL_SECONDS=120
SSE_HEARTBEAT_INTERVAL_MS=30000

# S8 admin / audit / DevOps MCP
LEGAL_AUDIT_RETENTION_DAYS=365
PARTON_MCP_API_KEY=
PARTON_RELEASE=dev
PARTON_GIT_SHA=local
PARTON_API_BASE_URL=http://localhost:3000/api/v1
PARTON_ADMIN_TOKEN=

# --- Admin Vite ---
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:3000

# --- Marketing ---
VITE_SITE_URL=https://www.parton.com.tr
VITE_IOS_STORE_URL=https://apps.apple.com/app/parton
VITE_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.parton.app
VITE_EMPLOYER_LOGIN_URL=https://console.parton.com.tr/login
