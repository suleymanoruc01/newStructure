# PartOn edge. Copy snippets into /etc/nginx/snippets/ and this file into
# sites-available. Cert files stay on the host (Let's Encrypt); do not commit keys.
# Nest listens on 127.0.0.1:3000 (PM2). Admin SPA is Vite base /admin.

upstream parton_api {
  server 127.0.0.1:3000;
  keepalive 32;
}

server {
  listen 80;
  server_name api.parton.app xadmin.parton.app devops.parton.app;
  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    default_type text/plain;
  }
  location / {
    return 301 https://$host$request_uri;
  }
}

# Backend. SSE is GET /api/v1/realtime/stream (heartbeat default 30s, max 120s).
server {
  listen 443 ssl http2;
  server_name api.parton.app;

  ssl_certificate     /etc/letsencrypt/live/api.parton.app/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/api.parton.app/privkey.pem;
  include snippets/ssl-params.conf;

  client_max_body_size 2m;

  location /api/v1/realtime/ {
    include snippets/proxy-params.conf;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 24h;
    proxy_send_timeout 24h;
    proxy_pass http://parton_api;
  }

  location /api/ {
    include snippets/proxy-params.conf;
    proxy_pass http://parton_api;
  }

  location /health/ {
    include snippets/proxy-params.conf;
    proxy_pass http://parton_api/api/v1/health/;
  }

  location = / {
    default_type application/json;
    return 200 '{"service":"parton-api","base":"/api/v1"}';
  }
}

# Admin console. BrowserRouter basename is /admin. Refresh cookie is host-only,
# so /api on this host must reach Nest too.
server {
  listen 443 ssl http2;
  server_name xadmin.parton.app;

  ssl_certificate     /etc/letsencrypt/live/api.parton.app/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/api.parton.app/privkey.pem;
  include snippets/ssl-params.conf;

  client_max_body_size 2m;

  location = / {
    return 302 /admin/;
  }

  location /admin/ {
    root /var/www/parton;
    try_files $uri $uri/ /admin/index.html;
  }

  location /api/ {
    include snippets/proxy-params.conf;
    proxy_pass http://parton_api;
  }
}

# DevOps screens live in the same SPA at /admin/devops. MCP stays stdio and
# calls https://api.parton.app; it is not published on this port.
server {
  listen 443 ssl http2;
  server_name devops.parton.app;

  ssl_certificate     /etc/letsencrypt/live/api.parton.app/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/api.parton.app/privkey.pem;
  include snippets/ssl-params.conf;

  client_max_body_size 2m;

  location = / {
    return 302 /admin/devops;
  }

  location /admin/ {
    root /var/www/parton;
    try_files $uri $uri/ /admin/index.html;
  }

  location /api/ {
    include snippets/proxy-params.conf;
    proxy_pass http://parton_api;
  }
}
